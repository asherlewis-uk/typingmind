const fastify = require('fastify')({ logger: true });
const cors = require('@fastify/cors');
const multipart = require('@fastify/multipart');
const mysql = require('mysql2/promise');
const { Pool } = require('pg');
const Minio = require('minio');
const { v4: uuidv4 } = require('uuid');
const crypto = require('crypto');
const { Readable } = require('stream');

// ─── Configuration ───────────────────────────────────────────────────────────
const PORT = process.env.PORT || 3000;
const DOMAIN = process.env.DOMAIN || 'typingmind.yourdomain.com';
const OPENAI_API_KEY = process.env.OPENAI_API_KEY || '';
const ELEVENLABS_API_KEY = process.env.ELEVENLABS_API_KEY || '';

const MYSQL_CONFIG = {
  host: process.env.MYSQL_HOST || 'mysql',
  port: parseInt(process.env.MYSQL_PORT || '3306', 10),
  user: process.env.MYSQL_USER || 'typingmind',
  password: process.env.MYSQL_PASSWORD || 'change-me-db-123',
  database: process.env.MYSQL_DATABASE || 'typingmind',
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0,
};

const PG_CONFIG = {
  host: process.env.PG_HOST || 'postgres',
  port: parseInt(process.env.PG_PORT || '5432', 10),
  user: process.env.PG_USER || 'typingmind',
  password: process.env.PG_PASSWORD || 'change-me-pg-123',
  database: process.env.PG_DATABASE || 'typingmind',
  max: 10,
};

const MINIO_CONFIG = {
  endPoint: new URL(process.env.MINIO_ENDPOINT || 'http://minio:9000').hostname,
  port: parseInt(new URL(process.env.MINIO_ENDPOINT || 'http://minio:9000').port || '9000', 10),
  useSSL: (process.env.MINIO_ENDPOINT || 'http://minio:9000').startsWith('https'),
  accessKey: process.env.MINIO_ACCESS_KEY || 'minio-typingmind',
  secretKey: process.env.MINIO_SECRET_KEY || 'change-me-minio-123',
};

const MINIO_BUCKET = process.env.MINIO_BUCKET || 'typingmind';

// ─── Database Clients ────────────────────────────────────────────────────────
let mysqlPool;
let pgPool;
let minioClient;

async function initDatabases() {
  mysqlPool = mysql.createPool(MYSQL_CONFIG);
  pgPool = new Pool(PG_CONFIG);

  minioClient = new Minio.Client(MINIO_CONFIG);

  const bucketExists = await minioClient.bucketExists(MINIO_BUCKET);
  if (!bucketExists) {
    await minioClient.makeBucket(MINIO_BUCKET);
    fastify.log.info(`Created MinIO bucket: ${MINIO_BUCKET}`);
  }

  const policy = {
    Version: '2012-10-17',
    Statement: [
      {
        Effect: 'Allow',
        Principal: { AWS: ['*'] },
        Action: ['s3:GetObject'],
        Resource: [`arn:aws:s3:::${MINIO_BUCKET}/blobs/*`],
      },
    ],
  };
  await minioClient.setBucketPolicy(MINIO_BUCKET, JSON.stringify(policy));
  fastify.log.info(`Set public-read policy on ${MINIO_BUCKET}/blobs/*`);

  // Test connections
  await mysqlPool.execute('SELECT 1');
  await pgPool.query('SELECT 1');
  fastify.log.info('Database connections established');
}

// ─── CORS ────────────────────────────────────────────────────────────────────
fastify.register(cors, {
  origin: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization', 'x-license-token'],
  credentials: true,
});

// ─── Multipart ───────────────────────────────────────────────────────────────
fastify.register(multipart, {
  limits: {
    fileSize: 200 * 1024 * 1024, // 200 MB
  },
});

// ─── Helpers ─────────────────────────────────────────────────────────────────
function generateId() {
  return uuidv4();
}

function generateDeleteToken() {
  return crypto.randomBytes(32).toString('hex');
}

function userMessageReply(message, statusCode = 400) {
  return { userMessage: message };
}

// ─── Health ──────────────────────────────────────────────────────────────────
fastify.get('/health', async () => ({ status: 'ok' }));

// ═══════════════════════════════════════════════════════════════════════════════
// 1. FILE UPLOAD & STORAGE
// ═══════════════════════════════════════════════════════════════════════════════

// POST /api/hosted/blobs
fastify.post('/api/hosted/blobs', async (request, reply) => {
  const data = await request.file();
  if (!data) {
    reply.status(400);
    return userMessageReply('No file provided');
  }

  const blobID = generateId();
  const storageKey = `blobs/${blobID}`;
  const mimeType = data.mimetype || 'application/octet-stream';
  const originalName = data.filename || 'unnamed';

  try {
    await minioClient.putObject(MINIO_BUCKET, storageKey, data.file, -1, {
      'Content-Type': mimeType,
    });

    // We don't have easy access to exact size after streaming; query MinIO
    const stat = await minioClient.statObject(MINIO_BUCKET, storageKey);
    const sizeBytes = stat.size || 0;

    await mysqlPool.execute(
      'INSERT INTO blobs (id, original_name, mime_type, size_bytes, storage_key) VALUES (?, ?, ?, ?, ?)',
      [blobID, originalName, mimeType, sizeBytes, storageKey]
    );

    reply.status(201);
    return {
      blobID,
      url: `/api/hosted/blobs/${blobID}`,
      mimeType,
    };
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to upload file');
  }
});

// GET /api/hosted/blobs/:blobID
fastify.get('/api/hosted/blobs/:blobID', async (request, reply) => {
  const { blobID } = request.params;

  try {
    const [rows] = await mysqlPool.execute(
      'SELECT storage_key, mime_type, original_name FROM blobs WHERE id = ?',
      [blobID]
    );

    if (!rows || rows.length === 0) {
      reply.status(404);
      return userMessageReply('Blob not found');
    }

    const blob = rows[0];
    const stream = await minioClient.getObject(MINIO_BUCKET, blob.storage_key);

    reply.header('Content-Type', blob.mime_type || 'application/octet-stream');
    reply.header('Content-Disposition', `inline; filename="${blob.original_name || 'download'}"`);
    return reply.send(stream);
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to retrieve file');
  }
});

// ═══════════════════════════════════════════════════════════════════════════════
// 2. VOICE / TTS PROXY
// ═══════════════════════════════════════════════════════════════════════════════

// POST /api/hosted/voice/openai
fastify.post('/api/hosted/voice/openai', async (request, reply) => {
  if (!OPENAI_API_KEY) {
    reply.status(503);
    return userMessageReply('OpenAI API key not configured');
  }

  try {
    const response = await fetch('https://api.openai.com/v1/audio/speech', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${OPENAI_API_KEY}`,
      },
      body: JSON.stringify(request.body),
    });

    if (!response.ok) {
      const text = await response.text();
      reply.status(response.status);
      return userMessageReply(`OpenAI TTS error: ${text}`);
    }

    reply.header('Content-Type', 'audio/mpeg');
    return reply.send(Readable.fromWeb(response.body));
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('TTS proxy failed');
  }
});

// GET /api/hosted-users/voice/voices
fastify.get('/api/hosted-users/voice/voices', async (request, reply) => {
  if (!ELEVENLABS_API_KEY) {
    reply.status(503);
    return userMessageReply('ElevenLabs API key not configured');
  }

  try {
    const response = await fetch('https://api.elevenlabs.io/v1/voices', {
      headers: {
        'xi-api-key': ELEVENLABS_API_KEY,
      },
    });

    if (!response.ok) {
      const text = await response.text();
      reply.status(response.status);
      return userMessageReply(`ElevenLabs error: ${text}`);
    }

    const data = await response.json();
    return data;
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Voice list proxy failed');
  }
});

// ═══════════════════════════════════════════════════════════════════════════════
// 3. SHARED LINKS & CONTENT
// ═══════════════════════════════════════════════════════════════════════════════

// POST /api/share
fastify.post('/api/share', async (request, reply) => {
  const { chatData, c } = request.body || {};
  if (!chatData) {
    reply.status(400);
    return userMessageReply('chatData is required');
  }

  const id = generateId();
  const deleteToken = generateDeleteToken();
  const url = `https://${DOMAIN}/s/${id}`;

  try {
    await mysqlPool.execute(
      'INSERT INTO shared_links (id, type, data, delete_token) VALUES (?, ?, ?, ?)',
      [id, 'chat', JSON.stringify({ chatData, c }), deleteToken]
    );

    reply.status(201);
    return { id, url, deleteToken };
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to create shared link');
  }
});

// GET /api/shared-links
fastify.get('/api/shared-links', async (request, reply) => {
  const { type } = request.query;

  try {
    let query = 'SELECT id, type, data, created_at FROM shared_links';
    const params = [];
    if (type) {
      query += ' WHERE type = ?';
      params.push(type);
    }
    query += ' ORDER BY created_at DESC';

    const [rows] = await mysqlPool.execute(query, params);

    return rows.map((row) => {
      let parsedData = {};
      try {
        parsedData = typeof row.data === 'string' ? JSON.parse(row.data) : row.data;
      } catch {
        parsedData = {};
      }
      return {
        id: row.id,
        type: row.type,
        createdAt: row.created_at ? new Date(row.created_at).toISOString() : null,
        data: parsedData,
      };
    });
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to retrieve shared links');
  }
});

