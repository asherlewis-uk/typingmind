// ═══════════════════════════════════════════════════════════════════════════════
// 4. KNOWLEDGE BASE (RAG)
// ═══════════════════════════════════════════════════════════════════════════════

async function getEmbedding(text) {
  if (!OPENAI_API_KEY) {
    throw new Error('OpenAI API key not configured');
  }

  const response = await fetch('https://api.openai.com/v1/embeddings', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${OPENAI_API_KEY}`,
    },
    body: JSON.stringify({
      model: 'text-embedding-3-small',
      input: text,
    }),
  });

  if (!response.ok) {
    const text = await response.text();
    throw new Error(`Embedding API error: ${text}`);
  }

  const data = await response.json();
  return data.data[0].embedding;
}

// POST /api/cloud/knowledge/query
fastify.post('/api/cloud/knowledge/query', async (request, reply) => {
  const { query, topK = 5, tags = [] } = request.body || {};
  if (!query) {
    reply.status(400);
    return userMessageReply('query is required');
  }

  try {
    const embedding = await getEmbedding(query);
    const embeddingStr = `[${embedding.join(',')}]`;

    let sql = `
      SELECT
        d.id,
        d.title,
        d.content,
        d.metadata,
        d.source,
        1 - (d.embedding <=> $1::vector) AS score
      FROM knowledge_documents d
    `;
    const params = [embeddingStr];

    if (tags.length > 0) {
      sql += `
        INNER JOIN knowledge_document_tags dt ON dt.document_id = d.id
        INNER JOIN knowledge_tags t ON t.id = dt.tag_id
        WHERE t.name = ANY($2)
      `;
      params.push(tags);
    }

    sql += `
      ORDER BY d.embedding <=> $1::vector
      LIMIT $${params.length + 1}
    `;
    params.push(topK);

    const { rows } = await pgPool.query(sql, params);

    return {
      results: rows.map((r) => ({
        id: r.id,
        title: r.title,
        content: r.content,
        score: parseFloat(r.score),
      })),
    };
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply(err.message || 'Knowledge query failed');
  }
});

// POST /api/cloud/knowledge/read
fastify.post('/api/cloud/knowledge/read', async (request, reply) => {
  const { documentIDs } = request.body || {};
  if (!Array.isArray(documentIDs) || documentIDs.length === 0) {
    reply.status(400);
    return userMessageReply('documentIDs array is required');
  }

  try {
    const { rows } = await pgPool.query(
      'SELECT id, title, content, metadata, source, created_at, updated_at FROM knowledge_documents WHERE id = ANY($1)',
      [documentIDs]
    );

    return rows.map((r) => ({
      id: r.id,
      title: r.title,
      content: r.content,
      metadata: r.metadata,
      source: r.source,
      createdAt: r.created_at ? new Date(r.created_at).toISOString() : null,
      updatedAt: r.updated_at ? new Date(r.updated_at).toISOString() : null,
    }));
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to read documents');
  }
});

// GET /api/cloud/knowledge/tags
fastify.get('/api/cloud/knowledge/tags', async (request, reply) => {
  try {
    const { rows } = await pgPool.query(
      'SELECT id, name, color, created_at FROM knowledge_tags ORDER BY name'
    );

    return rows.map((r) => ({
      id: r.id,
      name: r.name,
      color: r.color,
      createdAt: r.created_at ? new Date(r.created_at).toISOString() : null,
    }));
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to retrieve tags');
  }
});

// POST /api/hosted/dynamic-context-endpoint-test
fastify.post('/api/hosted/dynamic-context-endpoint-test', async (request, reply) => {
  const { endpoint, headers = {} } = request.body || {};
  if (!endpoint) {
    reply.status(400);
    return userMessageReply('endpoint is required');
  }

  try {
    const response = await fetch(endpoint, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        ...headers,
      },
    });

    if (!response.ok) {
      return { success: false, error: `HTTP ${response.status}` };
    }

    const contentType = response.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
      return { success: false, error: 'Response is not JSON' };
    }

    // Verify it's parseable JSON
    await response.json();
    return { success: true };
  } catch (err) {
    request.log.error(err);
    return { success: false, error: err.message || 'Request failed' };
  }
});

// ═══════════════════════════════════════════════════════════════════════════════
// 5. SYNC (Optional)
// ═══════════════════════════════════════════════════════════════════════════════

// POST /api/sync-v2/blobs/:blobID
fastify.post('/api/sync-v2/blobs/:blobID', async (request, reply) => {
  const { blobID } = request.params;
  const data = await request.file();
  if (!data) {
    reply.status(400);
    return userMessageReply('No file provided');
  }

  const storageKey = `blobs/${blobID}`;
  const mimeType = data.mimetype || 'application/octet-stream';
  const originalName = data.filename || 'unnamed';

  try {
    await minioClient.putObject(MINIO_BUCKET, storageKey, data.file, -1, {
      'Content-Type': mimeType,
    });

    const stat = await minioClient.statObject(MINIO_BUCKET, storageKey);
    const sizeBytes = stat.size || 0;

    await mysqlPool.execute(
      `INSERT INTO blobs (id, original_name, mime_type, size_bytes, storage_key)
       VALUES (?, ?, ?, ?, ?)
       ON DUPLICATE KEY UPDATE
       original_name = VALUES(original_name),
       mime_type = VALUES(mime_type),
       size_bytes = VALUES(size_bytes),
       storage_key = VALUES(storage_key)`,
      [blobID, originalName, mimeType, sizeBytes, storageKey]
    );

    reply.status(201);
    return {
      blobID,
      url: `/api/hosted/blobs/${blobID}`,
      mimeType,
    };
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to upload sync blob');
  }
});

// ═══════════════════════════════════════════════════════════════════════════════
// START
// ═══════════════════════════════════════════════════════════════════════════════

async function start() {
  try {
    await initDatabases();
    await fastify.listen({ port: PORT, host: '0.0.0.0' });
    fastify.log.info(`Server listening on ${PORT}`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
}

start();
