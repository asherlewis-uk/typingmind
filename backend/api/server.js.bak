// GET /api/shared_characters/:id
fastify.get('/api/shared_characters/:id', async (request, reply) => {
  const { id } = request.params;

  try {
    const [rows] = await mysqlPool.execute(
      'SELECT character_data FROM shared_characters WHERE id = ?',
      [id]
    );

    if (!rows || rows.length === 0) {
      reply.status(404);
      return userMessageReply('Character not found');
    }

    let data = rows[0].character_data;
    if (typeof data === 'string') {
      try { data = JSON.parse(data); } catch { /* keep string */ }
    }
    return data;
  } catch (err) {
    request.log.error(err);
    reply.status(500);
    return userMessageReply('Failed to retrieve character');
  }
});

